{
  "name": "luyingzulin-uniapp",
  "private": true,
  "version": "1.0.0",
  "description": "露营装备租赁 uniapp 用户端",
  "scripts": {
    "dev:h5": "cross-env UNI_INPUT_DIR=. uni",
    "dev:integration": "cross-env UNI_INPUT_DIR=. uni --mode integration",
    "build:h5": "cross-env UNI_INPUT_DIR=. uni build",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=. uni build -p mp-weixin",
    "build": "cross-env UNI_INPUT_DIR=. uni build -p h5"
  },
  "dependencies": {
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.13",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-app": "3.0.0-4020920240930001",
    "@dcloudio/uni-app-plus": "3.0.0-4020920240930001",
    "@dcloudio/uni-automator": "3.0.0-4020920240930001",
    "@dcloudio/uni-cli-shared": "3.0.0-4020920240930001",
    "@dcloudio/uni-components": "3.0.0-4020920240930001",
    "@dcloudio/uni-h5": "3.0.0-4020920240930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4020920240930001",
    "@dcloudio/uni-stacktracey": "3.0.0-4020920240930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
    "cross-env": "^7.0.3",
    "sass": "^1.77.0",
    "vite": "5.2.8"
  }
}
